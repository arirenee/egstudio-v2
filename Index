// Multi-page SPA Routing Layer Engine
function switchView(viewId) {
const panes = document.querySelectorAll('.view-pane');
panes.forEach(pane => pane.classList.remove('active'));
const activePane = document.getElementById('view-' + viewId);
if(activePane) {
activePane.classList.add('active');
}
window.scrollTo({ top: 0, behavior: 'smooth' });
}
// Live Real-Time Mathematical Calculators Engine
const pageClientsSlider = document.getElementById('page-clients-slider');
const pagePriceSlider = document.getElementById('page-price-slider');
const pageClientCountDisp = document.getElementById('page-client-count');
const pagePriceDisp = document.getElementById('page-price-display');
const pageRevenueDisp = document.getElementById('page-revenue-display');
const pageCostDisp = document.getElementById('page-cost-display');
const pageProfitDisp = document.getElementById('page-profit-display');
const backendCostMultiplier = 1500;
function runPageCalculations() {
const clients = parseInt(pageClientsSlider.value);
const price = parseInt(pagePriceSlider.value);
pageClientCountDisp.textContent = clients;
pagePriceDisp.textContent = price.toLocaleString();
const inflowRevenue = clients * price;
const outflowCost = clients * backendCostMultiplier;
const netMarginMargin = inflowRevenue - outflowCost;
pageRevenueDisp.textContent = inflowRevenue.toLocaleString();
pageCostDisp.textContent = outflowCost.toLocaleString();
pageProfitDisp.textContent = netMarginMargin.toLocaleString();
}
pageClientsSlider.addEventListener('input', runPageCalculations);
pagePriceSlider.addEventListener('input', runPageCalculations);
// Modern AJAX Pipeline Form Interceptor Logic
function submitFormWithAjax(event) {
event.preventDefault();
const form = document.getElementById('onboardingForm');
const submitBtn = document.getElementById('submitBtn');
// Set UI to loading state
submitBtn.disabled = true;
submitBtn.innerHTML = <i class="fa-solid fa-spinner animate-spin"></i> <span>Transmitting Asset Link...</span>;
const formData = new FormData(form);
fetch('web3forms.com', {
method: 'POST',
body: formData
})
.then(async (response) => {
let json = await response.json();
if (response.status == 200) {
form.classList.add('hidden');
document.getElementById('formSuccessMessage').classList.remove('hidden');
} else {
alert(json.message || "Something went wrong. Please try again.");
resetSubmitButton();
}
})
.catch(error => {
alert("Network error. Please verify your internet connection.");
resetSubmitButton();
});
}
function resetSubmitButton() {
const submitBtn = document.getElementById('submitBtn');
submitBtn.disabled = false;
submitBtn.innerHTML = <span>Deploy Pipeline Engine Request</span>;
}
runPageCalculations();
